DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-secret"
PORT=4000

# SMTP configuration for the "send email" action.
# If left unset, emails are logged to the console and recorded in the
# action history instead of actually being sent (useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AdvChecklists <no-reply@advchecklists.local>"
